# Public origin for the SPA. Production: https://erudoza.com
PUBLIC_ORIGIN=http://localhost:5173
VITE_PUBLIC_ORIGIN=http://localhost:5173
# Empty for the local Vite proxy and the same-origin Sites worker proxy.
VITE_API_BASE_URL=
# Sites runtime target used by the worker proxy when a production API is available.
ERUDOZA_API_BASE_URL=

# Optional public donation profile. Empty disables all donation UI and widget loading.
# Use the real HTTPS Buy Me a Coffee profile after account/widget verification.
# Frontend Vite env files belong in apps/web/.env.local; the root .env is not loaded
# by the web workspace. Alternatively inject this variable into the build process.
# See docs/operations/buy-me-a-coffee.md. Never put payment secrets in VITE_ values.
VITE_BUY_ME_A_COFFEE_URL=

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Development/test default is SQLite so the vertical slice runs without Docker.
# Compose (infra/local/compose.yaml) provides SQL Server + Azurite.
Database__Provider=Sqlite
Database__ConnectionString=Data Source=erudoza.dev.db

# SQL Server (compose / production-like local)
# Database__Provider=SqlServer
# Database__ConnectionString=Server=localhost,1433;Database=erudoza;User Id=sa;Password=CHANGE_ME_LOCAL_ONLY;TrustServerCertificate=True

Blob__Provider=Disabled
# Blob__ConnectionString=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# Seeded development identities — not for production
Seed__Enabled=true
Seed__AdminEmail=admin@erudoza.local
Seed__AdminPassword=DevAdmin!234
Seed__StudentUsername=daniel.student
Seed__StudentPassword=DevStudent!234

ExposeDebugAnswers=true
