{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["worker/native/**/*.ts"],
  "exclude": ["worker/native/**/*.test.ts", "worker/native/test-runtime.ts", "worker/native/pbe/dispute-fixture.ts"]
}
