{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "erudoza-native",
  "main": "worker/native/index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "assets": { "directory": "dist-native", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "erudoza-native", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PracticeRoom" }, { "name": "REPORTS", "class_name": "PracticeReports" }, { "name": "PASSWORD_CRYPTO", "class_name": "PasswordCrypto" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PracticeRoom", "PracticeReports"] },
    { "tag": "v2-password-crypto", "new_sqlite_classes": ["PasswordCrypto"] }
  ]
}
